{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PS5 EmuTrack Compatibility Reports",
  "type": "object",
  "required": ["reports"],
  "properties": {
    "$schema": { "type": "string" },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["game", "emulator", "status", "verified", "date"],
        "additionalProperties": false,
        "properties": {
          "game": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "emulator": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "status": {
            "type": "string",
            "enum": ["nothing", "boots", "menus", "ingame", "playable"]
          },
          "verified": { "type": "boolean" },
          "date": { "type": "string", "format": "date" },
          "source": { "type": "string", "pattern": "^https://" },
          "evidence": { "type": "string", "pattern": "^https://" },
          "version": { "type": "string" },
          "hardware": { "type": "string" },
          "notes": { "type": "string" }
        },
        "if": { "properties": { "verified": { "const": true } } },
        "then": { "required": ["source"] }
      }
    }
  }
}
